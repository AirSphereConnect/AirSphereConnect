# =======================================
# 🌍 AirSphere Connect - Environment File
# =======================================
# ⚠️ Copy this file and rename it to `.env`
# ⚠️ Don't commit your real `.env` to GitHub
# =======================================

# ==============================
# 🗄️ DATABASE - MariaDB
# ==============================
MARIADB_VERSION=12.0.2
DB_CONTAINER_NAME=air-sphere-connect_db
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=air_sphere_connect
DB_USER=air_sphere_connect_user
DB_PASSWORD=your_db_password_here
DB_ROOT_PASSWORD=your_root_password_here
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_VOLUME_NAME=air-sphere-connect_db_data

# ==============================
# ⚙️ BACKEND - Spring Boot
# ==============================
BACKEND_CONTEXT=./air-sphere-connect-back
BACKEND_DOCKERFILE=Dockerfile.dev
BACKEND_CONTAINER_NAME=airsphere_backend
BACKEND_PORT=8080
DEBUG_PORT=5005
JAVA_TOOL_OPTIONS=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005


# Spring Boot configuration
SPRING_PROFILES_ACTIVE=dev
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# ==============================
# 💻 FRONTEND - Angular
# ==============================
FRONTEND_CONTEXT=./air-sphere-connect-front
FRONTEND_DOCKERFILE=Dockerfile.dev
FRONTEND_CONTAINER_NAME=airsphere_frontend
FRONTEND_PORT=4200
FRONTEND_INTERNAL_PORT=80

# ==============================
# 📧 MAIL SERVICE - MailHog
# ==============================
MAIL_HOST=mailhog
MAIL_PORT=1025

# ==============================
# 🌤️ EXTERNAL APIs (Optional)
# ==============================
WEATHER_API_KEY=your_weather_api_key_here
MAILJET_API_KEY=your_mailjet_api_key_here
MAILJET_API_SECRET=your_mailjet_api_secret_here

# ==============================
# 🌐 CORS & NETWORK
# ==============================
CORS_ORIGINS=http://localhost:4200
NETWORK_NAME=air-sphere-connect-network

# ==============================
# 📊 SONARQUBE - Code Quality
# ==============================
# URL du serveur SonarQube (localhost pour dev, URL serveur pour prod)
SONAR_HOST_URL=http://localhost:9000

# Token d'authentification SonarQube
# Générer depuis: SonarQube UI → My Account → Security → Generate Token
SONAR_TOKEN=your_sonarqube_token_here

# Clé du projet SonarQube
SONAR_PROJECT_KEY=air-sphere-connect

# ==============================
# 🔐 HEALTHCHECK
# ==============================
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=60s

# ==============================
# API Configuration
# ==============================
# URL de l'API (utilisée par le frontend)
API_URL=http://localhost:8080/api
NODE_ENV=development